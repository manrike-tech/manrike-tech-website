---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ProjectCard from './ProjectCard.astro';
import SocialLinks from './SocialLinks.astro';
import { getProjects } from '../lib/content';
import { siteConfig } from '../site.config';
import { url } from '../lib/urls';

interface Props {
  lang: 'en' | 'es';
}
const { lang } = Astro.props;
const entry = await getEntry('cv', lang);
if (!entry) throw new Error(`Missing CV data file src/content/cv/${lang}.yaml`);
const cv = entry.data;
const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 4);

const t = {
  en: {
    title: 'About & CV',
    description: 'Professional profile, technical skills, experience and selected projects.',
    placeholder:
      'This CV still contains placeholder content. Replace it in src/content/cv/en.yaml and set placeholder: false.',
    skills: 'Technical skills',
    experience: 'Experience',
    projects: 'Selected projects',
    achievements: 'Achievements',
    certifications: 'Certifications',
    education: 'Education',
    languages: 'Languages',
    contact: 'Contact',
    present: 'present',
    download: 'Download CV (PDF)',
    print: 'Print / save as PDF',
    other: 'Versión en español',
    otherHref: '/cv/es/',
    empty: 'To be added.',
  },
  es: {
    title: 'Sobre mí y CV',
    description: 'Perfil profesional, competencias técnicas, experiencia y proyectos destacados.',
    placeholder:
      'Este CV todavía contiene contenido de ejemplo. Sustitúyelo en src/content/cv/es.yaml y cambia placeholder: false.',
    skills: 'Competencias técnicas',
    experience: 'Experiencia',
    projects: 'Proyectos destacados',
    achievements: 'Logros',
    certifications: 'Certificaciones',
    education: 'Formación',
    languages: 'Idiomas',
    contact: 'Contacto',
    present: 'actualidad',
    download: 'Descargar CV (PDF)',
    print: 'Imprimir / guardar como PDF',
    other: 'English version',
    otherHref: '/cv/',
    empty: 'Pendiente de completar.',
  },
}[lang];

const pdf = siteConfig.cvPdf[lang];
const name = siteConfig.author.name;
const structuredData = name
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name,
        ...(siteConfig.author.jobTitle ? { jobTitle: siteConfig.author.jobTitle } : {}),
        url: new URL(url('/cv/'), Astro.site).href,
        sameAs: [siteConfig.social.github, siteConfig.social.linkedin].filter(Boolean),
      },
    ]
  : [];

// Empty sections are shown with a hint only while the CV is a placeholder.
const show = (list: unknown[]) => list.length > 0 || cv.placeholder;
---

<BaseLayout
  title={t.title}
  description={t.description}
  type="profile"
  lang={lang}
  structuredData={structuredData}
>
  <div class="container page cv">
    <div class="no-print">
      <Breadcrumbs items={[{ label: t.title }]} />
    </div>
    {cv.placeholder && (
      <p class="notice no-print" role="note">
        {t.placeholder}
      </p>
    )}

    <header class="cv-header">
      <p class="eyebrow">$ whoami</p>
      <h1>{name || siteConfig.name}</h1>
      <p class="headline">{cv.headline}</p>
      {cv.location && <p class="muted">{cv.location}</p>}
      <p class="summary">{cv.summary}</p>
      <div class="cv-actions no-print">
        {pdf ? (
          <a class="button button-primary" href={url(pdf)} download>
            {t.download}
          </a>
        ) : (
          <button class="button" type="button" data-print>
            {t.print}
          </button>
        )}
        <a class="button" href={url(t.otherHref)} hreflang={lang === 'en' ? 'es' : 'en'}>
          {t.other}
        </a>
      </div>
    </header>

    {show(cv.skills) && (
      <section class="section" aria-labelledby="skills">
        <div class="section-header">
          <h2 id="skills">{t.skills}</h2>
        </div>
        {cv.skills.length > 0 ? (
          <dl class="skills">
            {cv.skills.map((s) => (
              <div>
                <dt>{s.domain}</dt>
                <dd>
                  <ul class="tag-list">
                    {s.items.map((i) => (
                      <li class="badge">{i}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))}
          </dl>
        ) : (
          <p class="muted">{t.empty}</p>
        )}
      </section>
    )}

    {show(cv.experience) && (
      <section class="section" aria-labelledby="experience">
        <div class="section-header">
          <h2 id="experience">{t.experience}</h2>
        </div>
        {cv.experience.length > 0 ? (
          <ol class="timeline">
            {cv.experience.map((e) => (
              <li>
                <p class="meta">
                  {e.start} – {e.end || t.present}
                </p>
                <h3>
                  {e.role} · <span class="muted">{e.organization}</span>
                </h3>
                {e.summary && <p>{e.summary}</p>}
                {e.highlights.length > 0 && (
                  <ul>
                    {e.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        ) : (
          <p class="muted">{t.empty}</p>
        )}
      </section>
    )}

    {projects.length > 0 && (
      <section class="section" aria-labelledby="cv-projects">
        <div class="section-header">
          <h2 id="cv-projects">{t.projects}</h2>
        </div>
        <div class="grid">
          {projects.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </section>
    )}

    {show(cv.achievements) && (
      <section class="section" aria-labelledby="achievements">
        <div class="section-header">
          <h2 id="achievements">{t.achievements}</h2>
        </div>
        {cv.achievements.length > 0 ? (
          <ul>
            {cv.achievements.map((a) => (
              <li>{a}</li>
            ))}
          </ul>
        ) : (
          <p class="muted">{t.empty}</p>
        )}
      </section>
    )}

    <div class="cv-columns">
      {show(cv.certifications) && (
        <section class="section" aria-labelledby="certifications">
          <div class="section-header">
            <h2 id="certifications">{t.certifications}</h2>
          </div>
          {cv.certifications.length > 0 ? (
            <ul class="plain">
              {cv.certifications.map((c) => (
                <li>
                  {c.url ? <a href={c.url}>{c.name}</a> : c.name}
                  <span class="muted">
                    {' '}
                    · {c.issuer}
                    {c.date && ` · ${c.date}`}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">{t.empty}</p>
          )}
        </section>
      )}
      {show(cv.education) && (
        <section class="section" aria-labelledby="education">
          <div class="section-header">
            <h2 id="education">{t.education}</h2>
          </div>
          {cv.education.length > 0 ? (
            <ul class="plain">
              {cv.education.map((e) => (
                <li>
                  {e.title}
                  <span class="muted">
                    {' '}
                    · {e.institution} · {e.start} – {e.end || t.present}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">{t.empty}</p>
          )}
        </section>
      )}
      {show(cv.languages) && (
        <section class="section" aria-labelledby="languages">
          <div class="section-header">
            <h2 id="languages">{t.languages}</h2>
          </div>
          {cv.languages.length > 0 ? (
            <ul class="plain">
              {cv.languages.map((l) => (
                <li>
                  {l.name} <span class="muted">· {l.level}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">{t.empty}</p>
          )}
        </section>
      )}
    </div>

    <section class="section" aria-labelledby="contact">
      <div class="section-header">
        <h2 id="contact">{t.contact}</h2>
      </div>
      <SocialLinks />
    </section>
  </div>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .cv-header {
    max-width: var(--prose-width);
  }

  .headline {
    font-size: var(--step-2);
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .summary {
    margin-top: var(--space-4);
    font-size: var(--step-1);
  }

  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .skills {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    margin: 0;
  }

  .skills dt {
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .skills dd {
    margin: 0;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline > li {
    padding: 0 0 var(--space-5) var(--space-5);
    border-left: 1px solid var(--border);
  }

  .timeline h3 {
    font-size: var(--step-1);
  }

  .cv-columns {
    display: grid;
    gap: 0 var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .plain {
    list-style: none;
    padding: 0;
  }

  .plain li + li {
    margin-top: var(--space-2);
  }
</style>
