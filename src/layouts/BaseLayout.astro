---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../site.config';
import { jsonLd } from '../lib/content-utils';
import { url } from '../lib/urls';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative image path for Open Graph. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  modified?: Date;
  tags?: string[];
  noindex?: boolean;
  lang?: string;
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description = siteConfig.description,
  image = '/og-default.png',
  imageAlt = `${siteConfig.name} — ${siteConfig.tagline}`,
  type = 'website',
  published,
  modified,
  tags = [],
  noindex = false,
  lang = siteConfig.locale,
  structuredData = [],
} = Astro.props;

const fullTitle = title
  ? `${title} · ${siteConfig.name}`
  : `${siteConfig.name} — ${siteConfig.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image.startsWith('/') ? url(image) : image, Astro.site).href;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0e1013" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} blog`}
      href={new URL(url('/rss.xml'), Astro.site)}
    />

    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title ?? siteConfig.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {tags.map((t) => (
      <meta property="article:tag" content={t} />
    ))}

    {structuredData.map((d) => (
      <script type="application/ld+json" set:html={jsonLd(d)} />
    ))}

    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {
        /* storage unavailable: keep the dark default */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
