---
import type { GetStaticPaths } from 'astro';
import BlogListing from '../../../components/BlogListing.astro';
import { getCategories, getPosts } from '../../../lib/content';

// One page per category that has posts, directly or through a subcategory.
export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const categories = await getCategories();
  return categories.list
    .map((category) => {
      const ids = categories.descendants(category.id);
      return { category, posts: posts.filter((p) => ids.has(p.data.category.id)) };
    })
    .filter(({ posts }) => posts.length > 0)
    .map(({ category, posts }) => ({
      params: { category: category.id },
      props: { category, posts },
    }));
}) satisfies GetStaticPaths;

const { category, posts } = Astro.props;
---

<BlogListing
  title={category.title}
  metaTitle={`${category.title}: blog articles`}
  description={`Blog articles about ${category.title}. ${category.description}`}
  posts={posts}
  breadcrumbs={[{ label: 'Blog', href: '/blog/' }, { label: category.title }]}
/>
