---
// Dark is the default. The initial theme is applied by an inline script in
// BaseLayout before first paint; this element only switches and persists it.
---

<theme-toggle>
  <button class="icon-button" type="button" aria-label="Switch to light theme" hidden>
    <svg class="icon-sun" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
      <circle cx="10" cy="10" r="3.5" stroke="currentColor" stroke-width="1.6" fill="none"></circle>
      <path
        d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M4 16l1.4-1.4M14.6 5.4 16 4"
        stroke="currentColor"
        stroke-width="1.6"
      ></path>
    </svg>
    <svg class="icon-moon" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
      <path
        d="M16.5 12.5A7 7 0 0 1 7.5 3.5a7 7 0 1 0 9 9Z"
        stroke="currentColor"
        stroke-width="1.6"
        fill="none"
      ></path>
    </svg>
  </button>
</theme-toggle>

<script>
  class ThemeToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      if (!button) return;
      button.hidden = false;
      const sync = () => {
        const light = document.documentElement.dataset.theme === 'light';
        button.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
        button.setAttribute('aria-pressed', String(light));
      };
      sync();
      button.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          // Storage may be unavailable (private mode); the toggle still works per page.
        }
        sync();
      });
    }
  }
  customElements.define('theme-toggle', ThemeToggle);
</script>

<style>
  .icon-button[hidden] {
    display: none;
  }
  :global([data-theme='light']) .icon-sun,
  :global(:root:not([data-theme='light'])) .icon-moon {
    display: none;
  }
</style>
