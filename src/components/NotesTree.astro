---
import type { CategoryNode } from '../lib/content-utils';
import type { Note } from '../lib/content';
import { noteKindLabel } from '../lib/content';
import { url } from '../lib/urls';

interface Props {
  nodes: CategoryNode[];
  notes: Note[];
  /** Category ids that contain notes, directly or in a subcategory. */
  populated: Set<string>;
  level?: number;
}
const { nodes, notes, populated, level = 2 } = Astro.props;
const Heading = `h${Math.min(level, 4)}` as 'h2' | 'h3' | 'h4';
---

{nodes
  .filter((n) => populated.has(n.id))
  .map((node) => {
    const own = notes.filter((n) => n.data.category.id === node.id);
    return (
      <section class:list={['tree-node', `level-${level}`]} aria-labelledby={`cat-${node.id}`}>
        <Heading id={`cat-${node.id}`}>
          <a href={url(`/categories/${node.id}/`)}>{node.title}</a>
        </Heading>
        {own.length > 0 && (
          <ul class="note-list">
            {own.map((note) => (
              <li>
                <a href={url(`/notes/${note.id}/`)}>{note.data.title}</a>
                <span class="badge badge-accent">{noteKindLabel[note.data.kind]}</span>
                {note.data.draft && <span class="badge badge-warn">draft</span>}
              </li>
            ))}
          </ul>
        )}
        <Astro.self nodes={node.children} notes={notes} populated={populated} level={level + 1} />
      </section>
    );
  })}

<style>
  .tree-node {
    margin-top: var(--space-5);
  }

  .tree-node .tree-node {
    margin-top: var(--space-3);
    padding-left: var(--space-4);
    border-left: 1px solid var(--border);
  }

  h2 {
    font-size: var(--step-2);
  }

  h3,
  h4 {
    font-size: var(--step-1);
    font-family: var(--font-mono);
  }

  h2 a,
  h3 a,
  h4 a {
    color: var(--text);
    text-decoration: none;
  }

  h2 a:hover,
  h3 a:hover,
  h4 a:hover {
    color: var(--accent);
  }

  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .note-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: 1px dashed var(--border);
  }
</style>
